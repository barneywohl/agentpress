{
  "name": "@agent_press/mcp-server",
  "version": "1.0.0-rc.1",
  "description": "MCP server that exposes any agents.txt file as queryable tools and resources. Plug into Claude Code, Cursor, Devin, and any other MCP-speaking agent.",
  "type": "module",
  "bin": {
    "agentpress-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "agents.txt",
    "agentpress",
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "claude-code",
    "cursor",
    "devin"
  ],
  "license": "MIT",
  "homepage": "https://github.com/barneywohl/agentpress/tree/main/packages/mcp-server",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/barneywohl/agentpress.git",
    "directory": "packages/mcp-server"
  },
  "bugs": {
    "url": "https://github.com/barneywohl/agentpress/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@agent_press/core": "^1.0.0-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
