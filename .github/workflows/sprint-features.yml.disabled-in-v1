name: Sprint Features CI

on:
  push:
    branches: [main, "release/**", "rc/**"]
    paths:
      - scripts/agentpress.py
      - tests/test_sprint_features.py
      - tests/test_painpoint_target_pack.py
      - pyproject.toml
  pull_request:
    paths:
      - scripts/agentpress.py
      - tests/test_sprint_features.py
      - tests/test_painpoint_target_pack.py
      - pyproject.toml

jobs:
  gates:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"
      - name: Install test dependencies
        run: python3 -m pip install pytest
      - name: Syntax check
        run: python3 -m py_compile scripts/agentpress.py
      - name: Lint
        run: python3 scripts/agentpress.py lint . --allow-warnings --json
      - name: Docs command check
        run: python3 scripts/agentpress.py docs-command-check --json
      - name: Schema validate all
        run: python3 scripts/agentpress.py schema-validate-all --json
      - name: Doctor
        run: python3 scripts/agentpress.py doctor --json
      - name: Pytest sprint features
        run: python3 -m pytest tests/test_sprint_features.py tests/test_painpoint_target_pack.py -v
      - name: first-user-bootstrap smoke
        run: python3 scripts/agentpress.py first-user-bootstrap --platform cline --json
      - name: proof-capture smoke
        run: python3 scripts/agentpress.py proof-capture --task-id ci-001 --evidence-dir /tmp/ci-proof --json
      - name: sandbox-guard smoke
        run: python3 scripts/agentpress.py sandbox-guard --scope read-only --paths ./src --no-write --json
      - name: adoption-tracker smoke
        run: python3 scripts/agentpress.py adoption-tracker --period 7d --no-write --json
      - name: handoff-pack smoke
        run: python3 scripts/agentpress.py handoff-pack --from glm --to rflo --task-id ci-test --no-write --json
      - name: batch-painpoints smoke
        run: |
          echo '[]' > /tmp/ci-issues.json
          python3 scripts/agentpress.py batch-painpoints --input /tmp/ci-issues.json --output /tmp/ci-outreach --json
      - name: release-candidate smoke
        run: python3 scripts/agentpress.py release-candidate --version 0.2.0-rc --no-write --json

  npm-pack:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: "20"
      - name: npm pack dry-run
        run: npm pack --dry-run
