{
  "name": "@agent_press/agentpress",
  "version": "0.2.0-rc.8",
  "private": false,
  "description": "Agent-native static instruction surfaces, validators, and CLI tools.",
  "bin": {
    "agentpress": "./bin/agentpress.js"
  },
  "scripts": {
    "doctor": "python3 scripts/agentpress.py doctor --json",
    "quickstart:onboard": "node bin/agentpress.js quickstart --agent-id local-agent --runtime codex --out /tmp/agentpress-quickstart --json",
    "validate": "python3 scripts/validate_agentpress_assets.py && python3 scripts/agentpress.py consistency-check --json"
  },
  "keywords": [
    "agents",
    "llms",
    "publishing",
    "static-site",
    "agentpress"
  ],
  "license": "MIT",
  "files": [
    "bin/",
    "scripts/agentpress.py",
    "scripts/mission_broker_scope_guard.py",
    "scripts/validate_agentpress_assets.py",
    "agentpress/schemas/",
    "agentpress/templates/",
    "agentpress/articles/article-index.json",
    "agentpress/examples/api-docs-handoff/",
    "agentpress/examples/agent-knowledge-sharing/",
    "agentpress/examples/runnable-onboarding/",
    "agentpress/search/search-index.json",
    "agentpress/self-tests/standard-suite.json",
    "agentpress/tools/agentpress-tools.json",
    "agentpress/releases/release-index.json",
    "agentpress/releases/README.md",
    "agentpress/install/install.py",
    "agentpress/install/install-catalog.json",
    "agentpress/install/package-registry-fallback-matrix.json",
    "agentpress/install/README.md",
    "agentpress/AGENT_START_HERE.md",
    "agentpress/CLI_AGENT_LAUNCH.md",
    "agentpress/README.md",
    "agentpress/QUICKSTART.md",
    "agentpress/PUBLISH_CANDIDATE_BUILDER.md",
    "agentpress/package-registry/README.md",
    ".well-known/agentpress.json",
    ".well-known/ai-ingestion.json",
    "agent-sitemap.xml",
    "sitemap.xml",
    "llms.txt",
    "AGENTS.md",
    "tests/fixtures/source-docs/",
    "README.md",
    "scripts/package_registry_verify.py",
    "agentpress/cli/*.py",
    "agentpress/examples/browser-agent-bootstrap-kit/",
    "agentpress/examples/visual-agent-bootstrap-kit/",
    "agentpress/compatibility/",
    "agentpress/security/",
    "agentpress/evals/",
    "agentpress/public-material-kits/",
    "agentpress/material-kits/"
  ],
  "homepage": "https://agentpress.pages.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/barneywohl/agentpress.git"
  },
  "bugs": {
    "url": "https://github.com/barneywohl/agentpress/issues"
  }
}
