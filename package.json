{
  "name": "@agent_press/agentpress",
  "version": "0.2.0-rc.2",
  "private": false,
  "description": "AgentPress is the llms.txt + agent onboarding kit for repos: publish AI-readable instructions, .well-known entrypoints, schema gates, proof receipts, and CLI checks for Claude, GPT/Codex, Cursor, MCP, LangChain, CrewAI, OpenHands, Cline, and RAG agents.",
  "bin": {
    "agentpress": "bin/agentpress.js"
  },
  "scripts": {
    "doctor": "python3 scripts/agentpress.py doctor --json",
    "validate": "python3 scripts/validate_agentpress_assets.py && python3 scripts/agentpress.py consistency-check --json"
  },
  "keywords": [
    "agentpress",
    "llms.txt",
    "llms-txt",
    "ai-agents",
    "agent-onboarding",
    "agentic-ai",
    "ai-agent-framework",
    "ai-agent-tools",
    "agent-protocol",
    "agent-contracts",
    "agent-instructions",
    "machine-readable",
    "well-known",
    "ai-ingestion",
    "repo-onboarding",
    "repository-analysis",
    "developer-experience",
    "schema-validation",
    "proof-receipts",
    "agent-readiness",
    "claude",
    "claude-code",
    "openai",
    "gpt",
    "codex",
    "cursor",
    "mcp",
    "model-context-protocol",
    "langchain",
    "crewai",
    "openhands",
    "cline",
    "roo-code",
    "rag",
    "llm-tools",
    "cli",
    "static-site",
    "autonomous-agents",
    "agent-sdk",
    "publishing",
    "developer-tools"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "homepage": "https://barneywohl.github.io/agentpress/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/barneywohl/agentpress.git"
  },
  "bugs": {
    "url": "https://github.com/barneywohl/agentpress/issues"
  },
  "main": "bin/agentpress.js",
  "files": [
    "bin/agentpress.js",
    "scripts/*.py",
    "scripts/*.sh",
    "agentpress/",
    "agentpress_cli/*.py",
    "README.md",
    "LICENSE*",
    "llms.txt",
    "sitemap.xml",
    "robots.txt",
    "index.html",
    "metadata.json",
    "openapi.yaml"
  ],
  "author": "Barney Wohl <barney@agentpress.dev>",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
