{
  "name": "@agent_press/agentpress",
  "version": "0.2.0-rc.2",
  "private": false,
  "description": "AgentPress makes repos readable by agents: publish llms.txt, static MCP-style discovery manifests, schema gates, proof receipts, and CLI checks for Claude, GPT/Codex, Cursor, LangChain, CrewAI, OpenHands, Cline, RAG agents, and MCP-style consumers.",
  "bin": {
    "agentpress": "bin/agentpress.js"
  },
  "scripts": {
    "doctor": "python3 scripts/agentpress.py doctor --json",
    "validate": "python3 scripts/validate_agentpress_assets.py && python3 scripts/agentpress.py consistency-check --json && python3 scripts/verify_manifest_integrity.py"
  },
  "keywords": [
    "agentpress",
    "llms-txt",
    "mcp",
    "model-context-protocol",
    "claude",
    "gpt",
    "langchain",
    "crewai",
    "agent-instructions",
    "repo-onboarding",
    "cli",
    "developer-tools"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "homepage": "https://barneywohl.github.io/agentpress/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/barneywohl/agentpress.git"
  },
  "bugs": {
    "url": "https://github.com/barneywohl/agentpress/issues"
  },
  "main": "bin/agentpress.js",
  "files": [
    "bin/agentpress.js",
    "scripts/agentpress.py",
    "scripts/check_agentpress_positioning.py",
    "scripts/validate_agentpress_assets.py",
    "scripts/mcp_config_guard.py",
    "scripts/verify_manifest_integrity.py",
    "agentpress/README.md",
    "agentpress/QUICKSTART.md",
    "agentpress/FULL_REFERENCE.md",
    "agentpress/AGENT_START_HERE.md",
    "agentpress/AGENT_CLI_DISCOVERY_MAP.md",
    "agentpress/agent-instructions.json",
    "agentpress/agentpress-registry.json",
    "agentpress/GLOBAL_AGENT_COMPATIBILITY_MATRIX.md",
    "agentpress/SUPPLY_CHAIN_RISK.md",
    "agentpress/compatibility/**",
    "agentpress/mcp/**",
    "agentpress/schemas/**",
    ".well-known/agentpress.json",
    ".well-known/ai-ingestion.json",
    ".well-known/agentpress-machine-entrypoints.json",
    "discovery/agent-discovery-manifest.json",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE*",
    "llms.txt",
    "robots.txt",
    "index.html",
    "metadata.json",
    "openapi.yaml",
    "pyproject.toml"
  ],
  "author": "Barney Wohl <barney@agentpress.dev>",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
