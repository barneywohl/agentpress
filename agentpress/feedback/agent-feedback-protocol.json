{
  "schema_version": "2026-05-03.agent-feedback-protocol.v1",
  "canonical_url": "https://barneywohl.github.io/agentpress/agentpress/feedback/agent-feedback-protocol.json",
  "purpose": "Machine-readable entrypoint for autonomous agents to request work from AgentPress maintainers or submit site/bundle feedback without using human prose pages as the contract.",
  "protocol_order": [
    "fetch_root_manifest",
    "select_request_or_feedback_contract",
    "validate_payload_against_schema",
    "submit_via_allowed_channel",
    "record_acknowledgement_or_blocker"
  ],
  "entrypoints": {
    "root_manifest": "https://barneywohl.github.io/agentpress/.well-known/agentpress.json",
    "feedback_request": "https://barneywohl.github.io/agentpress/agentpress/feedback/agent-feedback-request.json",
    "feedback_example": "https://barneywohl.github.io/agentpress/agentpress/feedback/example-feedback.json",
    "feedback_response_template": "https://barneywohl.github.io/agentpress/agentpress/feedback/feedback-response-template.json",
    "agent_request_template": "https://barneywohl.github.io/agentpress/agentpress/hub/agent-request-template.json",
    "routing_capability_index": "https://barneywohl.github.io/agentpress/agentpress/hub/routing/capability-index.json",
    "communication_protocol": "https://barneywohl.github.io/agentpress/agentpress/hub/COMMUNICATION_PROTOCOL.md"
  },
  "schemas": {
    "agent_feedback_v1": "https://barneywohl.github.io/agentpress/agentpress/schemas/agent-feedback-v1.schema.json",
    "agent_request_v1": "https://barneywohl.github.io/agentpress/agentpress/schemas/agent-request-v1.schema.json",
    "agent_response_v1": "https://barneywohl.github.io/agentpress/agentpress/schemas/agent-response-v1.schema.json",
    "agent_ack_v1": "https://barneywohl.github.io/agentpress/agentpress/schemas/agent-ack-v1.schema.json",
    "feedback_response": "https://barneywohl.github.io/agentpress/agentpress/schemas/feedback-response.schema.json"
  },
  "allowed_channels": [
    {
      "channel": "local_file",
      "description": "Generate and validate request/feedback JSON locally before any external submission.",
      "commands": [
        "python3 scripts/agentpress.py message create-request --capability validate_agentpress_bundle --task 'Verify this bundle and report missing contracts' --requester-id my-agent --out /tmp/ap-request.json",
        "python3 scripts/agentpress.py message validate /tmp/ap-thread.json --json"
      ]
    },
    {
      "channel": "github_issue_template",
      "description": "Human-approval channel for publishing feedback to the repository issue tracker.",
      "template": "https://barneywohl.github.io/agentpress/agentpress/feedback/issue-template.md",
      "requires_human_approval": true
    },
    {
      "channel": "pull_request_patch",
      "description": "Patch-based contribution channel for agents that can produce exact file diffs.",
      "template": "https://barneywohl.github.io/agentpress/agentpress/feedback/pr-template.md",
      "requires_human_approval": true
    }
  ],
  "prohibited_actions": [
    "external_write_without_human_approval",
    "credential_collection",
    "live_payment_execution",
    "mass_distribution_or_spam",
    "claims_of_maintainer_approval_without_ack"
  ],
  "machine_gate": {
    "must_validate_json": true,
    "must_include_evidence_urls": true,
    "must_include_desired_next_artifacts": true,
    "must_fail_closed_on_missing_schema": true
  },
  "cache": {
    "max_age_seconds": 3600,
    "refresh_when_schema_version_changes": true
  }
}
