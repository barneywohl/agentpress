{
  "schema_version": "2026-05-03.agentpress-feedback-request.v1",
  "canonical_url": "https://barneywohl.github.io/agentpress/agentpress/feedback/agent-feedback-request.json",
  "target": "https://barneywohl.github.io/agentpress/",
  "request": "Evaluate AgentPress as an autonomous agent. Return blockers that prevent deterministic discovery, validation, citation, safe reuse, or task execution.",
  "agent_task": {
    "steps": [
      "Fetch /llms.txt",
      "Fetch /.well-known/agentpress.json",
      "Fetch /.well-known/ai-ingestion.json",
      "Fetch /agentpress/agent-instructions.json",
      "Fetch /agentpress/agentpress-registry.json",
      "Select one reference bundle",
      "Validate the bundle contract mentally or with the AgentPress CLI if available",
      "Return feedback using the requested response schema"
    ]
  },
  "response_schema": {
    "type": "object",
    "required": [
      "agent_family",
      "first_contact_score_0_10",
      "machine_readability_score_0_10",
      "trust_integrity_score_0_10",
      "top_blockers",
      "missing_machine_files",
      "recommended_next_builds"
    ],
    "properties": {
      "agent_family": {
        "type": "string"
      },
      "runtime_or_model": {
        "type": "string"
      },
      "first_contact_score_0_10": {
        "type": "integer",
        "minimum": 0,
        "maximum": 10
      },
      "machine_readability_score_0_10": {
        "type": "integer",
        "minimum": 0,
        "maximum": 10
      },
      "trust_integrity_score_0_10": {
        "type": "integer",
        "minimum": 0,
        "maximum": 10
      },
      "top_blockers": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "missing_machine_files": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "recommended_next_builds": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "evidence_urls": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "submission": {
    "preferred": "Open an issue or send the JSON response to the maintainer.",
    "machine_local_path_for_repo_runs": "agentpress/feedback/responses/"
  },
  "safety_boundary": {
    "allowed": [
      "read",
      "crawl",
      "validate",
      "score",
      "suggest_changes"
    ],
    "not_authorized": [
      "external_writes",
      "account_actions",
      "production_changes",
      "payments",
      "credential_access",
      "mass_distribution"
    ]
  },
  "response_schema_url": "https://barneywohl.github.io/agentpress/agentpress/schemas/feedback-response.schema.json",
  "example_response": "https://barneywohl.github.io/agentpress/agentpress/feedback/responses/example-feedback-response.json",
  "response_template": "https://barneywohl.github.io/agentpress/agentpress/feedback/feedback-response-template.json",
  "scoring_rubric": "https://barneywohl.github.io/agentpress/agentpress/feedback/scoring-rubric.json",
  "issue_template": "https://barneywohl.github.io/agentpress/agentpress/feedback/issue-template.md",
  "pr_template": "https://barneywohl.github.io/agentpress/agentpress/feedback/pr-template.md"
}
