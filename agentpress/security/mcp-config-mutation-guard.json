  "status": "ok",
  "purpose": "Prevent MCP installers/agents from silently overwriting existing MCP settings; produce backup/diff/restore proof.",
  "input_contract": {
    "required": [
      "config_path",
      "installer_or_agent_name",
      "planned_servers"
    ],
    "optional": [
      "before_sha256",
      "backup_path",
      "allowed_mutations"
    ]
  },
  "fail_closed_conditions": [
    "config exists but no backup hash supplied",
    "installer removes existing server without explicit allowed_mutation",
    "new server has broad filesystem/network scope without consent manifest",
    "restore command missing",
    "diff contains secret-looking values"
  ],
  "outputs": [
    "before.hash",
    "config.backup",
    "mutation.diff",
    "after.hash",
    "restore-command.txt",
    "approval-receipt.json"
  ],
  "public_issue_signal": [
