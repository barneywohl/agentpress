{
  "schema_version": "2026-05-03.agentpress-agent-instructions.v1",
  "canonical_url": "https://barneywohl.github.io/agentpress/agentpress/agent-instructions.json",
  "purpose": "Deterministic execution instructions for autonomous agents consuming AgentPress.",
  "execution_order": [
    "GET /llms.txt",
    "GET /.well-known/agentpress.json",
    "GET /.well-known/ai-ingestion.json",
    "GET /agentpress/agentpress-registry.json",
    "GET /agentpress/payments/payment-policy.json if task may involve paid access, budgets, quotes, or x402",
    "Select bundle by task_type and target_agent_families",
    "GET bundle AGENT_ENTRYPOINT.md",
    "GET bundle agent-task-card.json",
    "GET bundle source-map.json",
    "GET bundle freshness.json",
    "GET bundle allowed-actions.json",
    "Run local CLI validation/audit/eval gates before reuse"
  ],
  "required_bundle_files": [
    "AGENT_ENTRYPOINT.md",
    "agent-task-card.json",
    "source-map.json",
    "freshness.json",
    "allowed-actions.json",
    ".well-known/ai-ingestion.json",
    "llms.txt",
    "sitemap.xml",
    "citation-policy.md",
    "disclaimer.md",
    "evals/*.jsonl"
  ],
  "allowed_public_actions": [
    "read",
    "crawl",
    "cite",
    "transform",
    "benchmark",
    "validate"
  ],
  "not_authorized_by_public_bundle": [
    "external_writes",
    "account_actions",
    "production_changes",
    "credential_access",
    "mass_distribution",
    "live_payments_or_wallet_use"
  ],
  "required_output_fields": [
    "selected_bundle",
    "task_understood",
    "sources_checked",
    "freshness_status",
    "allowed_actions",
    "missing_checks",
    "citations"
  ],
  "feedback_request": "https://barneywohl.github.io/agentpress/agentpress/feedback/agent-feedback-request.json",
  "schema_index": "https://barneywohl.github.io/agentpress/agentpress/schemas/index.json",
  "core_contract_schemas": {
    "agent-task-card.json": "https://barneywohl.github.io/agentpress/agentpress/schemas/agent-task-card.schema.json",
    "source-map.json": "https://barneywohl.github.io/agentpress/agentpress/schemas/source-map.schema.json",
    "freshness.json": "https://barneywohl.github.io/agentpress/agentpress/schemas/freshness.schema.json",
    "allowed-actions.json": "https://barneywohl.github.io/agentpress/agentpress/schemas/allowed-actions.schema.json",
    "feedback-response": "https://barneywohl.github.io/agentpress/agentpress/schemas/feedback-response.schema.json",
    "payment-policy": "https://barneywohl.github.io/agentpress/agentpress/schemas/payment-policy-v1.schema.json",
    "payment-capability": "https://barneywohl.github.io/agentpress/agentpress/schemas/payment-capability-v1.schema.json"
  },
  "payment_policy": "https://barneywohl.github.io/agentpress/agentpress/payments/payment-policy.json",
  "payment_capabilities": "https://barneywohl.github.io/agentpress/agentpress/payments/payment-capabilities.json",
  "x402_readiness": "https://barneywohl.github.io/agentpress/agentpress/payments/x402-readiness.json",
  "payment_posture": "Payment-aware, not payment-gated. Agents may read payment metadata and prepare unsigned quote requests, but public files do not authorize spend."
}
