{
  "$schema": "https://barneywohl.github.io/agentpress/agentpress/schemas/allowed-actions.schema.json",
  "schema_version": "0.1",
  "allowed": [
    "read",
    "crawl",
    "summarize",
    "cite",
    "translate",
    "transform",
    "benchmark",
    "package_offline",
    "open_issue",
    "create_pr_draft"
  ],
  "requires_human_approval": [
    "external_post",
    "registry_submission",
    "mass_distribution",
    "agent_directory_write",
    "production_deploy",
    "new_public_mirror"
  ],
  "prohibited": [
    "deceptive_tracking",
    "impersonation",
    "spam",
    "bypass_paywall",
    "private_data_access",
    "secret_request",
    "external_write_without_authorization",
    "remove_disclaimer"
  ]
}
