{
  "schema_version": "2026-05-03.agentpress-native-adapter.v1",
  "target": "cline",
  "status": "ok",
  "install_command": "python3 -m pip install git+https://github.com/barneywohl/agentpress.git",
  "entrypoint_guidance": "Use AgentPress tools via local CLI command templates; run docs-command-check and runtime-validation-harness before claiming support.",
  "required_agentpress_surfaces": {
    "tools": "https://barneywohl.github.io/agentpress/agentpress/tools/agentpress-tools.json",
    "mcp_catalog": "https://barneywohl.github.io/agentpress/agentpress/mcp/mcp-static-catalog.json",
    "approval_gates": "https://barneywohl.github.io/agentpress/agentpress/approvals/approval-gates.json",
    "permission_policy": "https://barneywohl.github.io/agentpress/agentpress/policies/tool-permission-policy.json",
    "runtime_validation": "https://barneywohl.github.io/agentpress/agentpress/runtime-validation/runtime-validation-harness.json",
    "proof_request": "https://barneywohl.github.io/agentpress/agentpress/proof-outreach/proof-request-pack.json"
  },
  "smoke_commands": [
    "agentpress doctor --json",
    "agentpress docs-command-check --json",
    "agentpress verify agentpress/examples/api-docs-handoff --strict-schema --json"
  ],
  "safety": "Follow approval gates before external effects; emit action ledger and proof receipts.",
  "proof_receipt_example": "https://barneywohl.github.io/agentpress/agentpress/adapters/native/cline/proof-receipt.example.json",
  "host_transcript_template": "https://barneywohl.github.io/agentpress/agentpress/adapters/native/cline/host-transcript.template.json",
  "proof_receipt_required_fields": [
    "agent_id",
    "runtime",
    "service_id",
    "capability_id",
    "commands_run",
    "artifacts",
    "result_status",
    "redaction_attestation"
  ]
}
