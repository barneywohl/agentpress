{
  "schema_version": "1.0",
  "agent_type": "glm",
  "agentpress_root": ".",
  "default_commands": {
    "search": "python3 scripts/agentpress.py search <query> --json",
    "self_test": "python3 scripts/agentpress.py self-test --agent-id glm-agent --out /tmp/glm-self-test.jsonl",
    "verify": "python3 scripts/agentpress.py verify <bundle> --json"
  },
  "safety": {
    "requires_human_approval": [
      "external_write",
      "production_change",
      "payment",
      "credential_access"
    ],
    "prohibited": [
      "private_data_extraction",
      "spam",
      "impersonation"
    ]
  }
}
