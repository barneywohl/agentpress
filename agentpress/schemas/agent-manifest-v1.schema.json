{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://barneywohl.github.io/agentpress/agentpress/schemas/agent-manifest-v1.schema.json",
  "title": "AgentPress Agent Manifest v1",
  "type": "object",
  "required": ["schema_version", "agent_id", "name", "capabilities", "entrypoints", "status"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "agent_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,80}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 120},
    "description": {"type": "string", "maxLength": 1000},
    "languages": {"type": "array", "items": {"type": "string"}},
    "regions": {"type": "array", "items": {"type": "string"}},
    "capabilities": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "entrypoints": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "uri"}},
    "input_requirements": {"type": "array", "items": {"type": "string"}},
    "output_formats": {"type": "array", "items": {"type": "string"}},
    "allowed_actions": {"type": "array", "items": {"type": "string"}},
    "requires_human_approval": {"type": "array", "items": {"type": "string"}},
    "prohibited_actions": {"type": "array", "items": {"type": "string"}},
    "status": {"type": "string", "enum": ["reference", "active", "experimental", "deprecated"]}
  },
  "additionalProperties": true
}
