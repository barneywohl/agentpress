{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://barneywohl.github.io/agentpress/agentpress/schemas/self-test-result-v1.schema.json",
  "title": "AgentPress Self-Test Result v1",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "agent_id",
    "test_id",
    "status",
    "created_utc"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "run_id": {
      "type": "string"
    },
    "agent_id": {
      "type": "string"
    },
    "test_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "skip"
      ]
    },
    "created_utc": {
      "type": "string"
    },
    "score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "evidence": {
      "type": "object"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
