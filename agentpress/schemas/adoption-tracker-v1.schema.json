{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://barneywohl.github.io/agentpress/agentpress/schemas/adoption-tracker-v1.schema.json",
  "title": "AgentPress Adoption Tracker v1",
  "description": "Output schema for `agentpress adoption-tracker`. Computes a privacy-safe local adoption funnel from receipt/proof JSON files — no IP or user-agent tracking.",
  "type": "object",
  "required": ["schema_version", "generated_utc", "status", "period", "root", "funnel", "conversion", "privacy"],
  "properties": {
    "schema_version": {"type": "string", "const": "2026-05-04.agentpress-adoption-tracker.v1"},
    "canonical_url": {"type": "string", "format": "uri"},
    "generated_utc": {"type": "string"},
    "status": {"type": "string", "enum": ["ok", "fail"]},
    "period": {"type": "string"},
    "root": {"type": "string"},
    "funnel": {
      "type": "object",
      "required": ["install_attempted", "doctor_ok", "proof_created", "outreach_ready", "external_reply", "issue_or_pr"],
      "properties": {
        "install_attempted": {"type": "integer", "minimum": 0},
        "doctor_ok": {"type": "integer", "minimum": 0},
        "proof_created": {"type": "integer", "minimum": 0},
        "outreach_ready": {"type": "integer", "minimum": 0},
        "external_reply": {"type": "integer", "minimum": 0},
        "issue_or_pr": {"type": "integer", "minimum": 0}
      }
    },
    "conversion": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "rate", "from_count", "to_count"],
        "properties": {
          "from": {"type": "string"},
          "to": {"type": "string"},
          "rate": {"type": "number", "minimum": 0, "maximum": 1},
          "from_count": {"type": "integer", "minimum": 0},
          "to_count": {"type": "integer", "minimum": 0}
        }
      }
    },
    "receipt_files_sample": {"type": "array", "items": {"type": "string"}, "maxItems": 50},
    "privacy": {"type": "string", "const": "local files only; no IP/user-agent tracking"}
  },
  "additionalProperties": true
}
