{
  "schema_version": "2026-05-02.agentpress-mcp-static.v1",
  "name": "AgentPress Static Tool Contracts",
  "description": "Static MCP-style contract map for agents that need deterministic AgentPress inputs and outputs without a live server.",
  "resources": [
    {"name": "root_llms", "uri": "https://barneywohl.github.io/agentpress/llms.txt", "mime_type": "text/plain"},
    {"name": "registry", "uri": "https://barneywohl.github.io/agentpress/agentpress/agentpress-registry.json", "mime_type": "application/json"},
    {"name": "article_index", "uri": "https://barneywohl.github.io/agentpress/agentpress/articles/article-index.json", "mime_type": "application/json"},
    {"name": "schemas", "uri": "https://barneywohl.github.io/agentpress/agentpress/schemas/README.md", "mime_type": "text/markdown"}
  ],
  "tools": [
    {
      "name": "agentpress_discover",
      "description": "Fetch AgentPress entrypoints and choose the correct bundle for a task.",
      "input_schema": {"type": "object", "required": ["task"], "properties": {"task": {"type": "string"}, "agent_family": {"type": "string"}}},
      "output_schema": {"type": "object", "required": ["bundle_url", "task_card_url", "allowed_actions_url"], "properties": {"bundle_url": {"type": "string"}, "task_card_url": {"type": "string"}, "allowed_actions_url": {"type": "string"}, "confidence": {"type": "string"}}}
    },
    {
      "name": "agentpress_validate_bundle",
      "description": "Validate a bundle against AgentPress required files and JSON contracts.",
      "input_schema": {"type": "object", "required": ["bundle_url"], "properties": {"bundle_url": {"type": "string"}}},
      "output_schema": {"type": "object", "required": ["status", "errors"], "properties": {"status": {"type": "string", "enum": ["pass", "fail"]}, "errors": {"type": "array", "items": {"type": "string"}}}}
    }
  ],
  "safety": {"default_mode": "read_only", "external_writes_require_human_approval": true}
}
