{
  "schema_version": "2026-05-03.agentpress-self-test-suite.v1",
  "suite_id": "agentpress-standard-suite-v1",
  "purpose": "Minimal executable proof that an agent can discover, validate, route, generate, search, and fail closed with AgentPress.",
  "tests": [
    {
      "test_id": "verify_bundle",
      "kind": "verify_bundle",
      "bundle": "agentpress/examples/api-docs-handoff",
      "description": "Verify canonical example bundle."
    },
    {
      "test_id": "search_capability",
      "kind": "search",
      "query": "message route capability",
      "description": "Find message routing capability through search index."
    },
    {
      "test_id": "message_thread",
      "kind": "message_thread",
      "description": "Create request, response, thread, and validate it."
    },
    {
      "test_id": "bundle_generator",
      "kind": "bundle_generator",
      "source": "tests/fixtures/source-docs",
      "description": "Generate and verify a bundle from source docs."
    },
    {
      "test_id": "negative_fixtures",
      "kind": "negative_fixtures",
      "description": "Prove broken bundles fail closed."
    }
  ]
}
