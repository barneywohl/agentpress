  "purpose": "Get a first agent user from zero to safe AgentPress install + MCP snippet + proof capture in one pack.",
  "steps": [
    {
      "step": 1,
      "name": "install",
      "command": "bash agentpress/install/install-agentpress.sh"
    },
    {
      "step": 2,
      "name": "doctor",
      "command": "python3 scripts/agentpress.py doctor --json"
    },
    {
      "step": 3,
      "name": "backup_and_guard_mcp_config",
      "command": "python3 scripts/agentpress.py mcp-config-mutation-guard --config-path cline_mcp_settings.json --backup --planned-servers agentpress --json"
    },
    {
      "step": 4,
      "name": "paste_mcp_snippet",
      "target": "Cline MCP settings",
      "snippet": {
        "mcpServers": {
          "agentpress": {
            "command": "python3",
            "args": [
              "scripts/agentpress.py",
              "mcp-catalog-export",
              "--json"
            ],
            "approval_required": true,
            "notes": "Run mcp-config-mutation-guard before applying."
          }
        }
      }
    },
    {
      "step": 5,
      "name": "restart_host",
      "instruction": "Reload Cline/VS Code after paste"
    },
    {
      "step": 6,
      "name": "capture_first_proof",
      "command": "python3 scripts/agentpress.py proof-capture --task-id first-run --evidence-dir /tmp/agentpress-proof --json"
    }
  ],
  "mcp_snippet": {
    "mcpServers": {
      "agentpress": {
        "command": "python3",
        "args": [
          "scripts/agentpress.py",
          "mcp-catalog-export",
          "--json"
        ],
        "approval_required": true,
        "notes": "Run mcp-config-mutation-guard before applying."
      }
    }
  },
