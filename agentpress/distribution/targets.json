{
  "schema_version": "2026-05-03.agentpress-distribution-targets.v1",
  "targets": [
    {
      "kind": "github_topics",
      "values": [
        "agentpress",
        "llms-txt",
        "ai-agents",
        "agent-tools",
        "rag",
        "mcp",
        "static-site"
      ]
    },
    {
      "kind": "directory_submission",
      "artifact": "agentpress/directory-submission/submission.json"
    },
    {
      "kind": "crawler_seed",
      "urls": [
        "https://barneywohl.github.io/agentpress/",
        "https://barneywohl.github.io/agentpress/llms.txt",
        "https://barneywohl.github.io/agentpress/.well-known/agentpress.json",
        "https://barneywohl.github.io/agentpress/agentpress/tools/agentpress-tools.json",
        "https://barneywohl.github.io/agentpress/agentpress/releases/release-index.json"
      ]
    }
  ],
  "requires_human_approval": [
    "external_post",
    "mass_distribution",
    "registry_submission"
  ],
  "primary_agent_cta": {
    "cli_launch_md": "https://barneywohl.github.io/agentpress/agentpress/CLI_AGENT_LAUNCH.md",
    "cli_launch_json": "https://barneywohl.github.io/agentpress/agentpress/cli-launch.json",
    "install_command": "python3 -c \"$(curl -fsSL https://barneywohl.github.io/agentpress/agentpress/install/install.py)\" --json"
  }
}
