{
  "schema_version": "2026-05-03.agentpress-queue-message-schema.v1",
  "required": [
    "message_id",
    "created_utc",
    "producer_agent_id",
    "capability",
    "task",
    "status",
    "attempt",
    "idempotency_key"
  ],
  "statuses": [
    "queued",
    "claimed",
    "completed",
    "failed",
    "dead_letter"
  ],
  "fields": {
    "message_id": "stable unique id",
    "idempotency_key": "dedupe key stable across retries",
    "lease_expires_utc": "claim timeout for retry",
    "attempt": "integer retry attempt",
    "max_attempts": "dead-letter threshold"
  }
}
