{
  "schema_version": "2026-05-04.agentpress-cline-roo-mcp-config-snippet.v1",
  "status": "ok",
  "purpose": "Example Cline/Roo MCP server snippet for AgentPress static catalog with consent guard.",
  "mcpServers": {
    "agentpress": {
